rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hunainhumail786@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isContentWrite() {
      return request.resource.data.keys().hasAll(['status', 'order', 'updatedAt'])
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.order is number
        && request.resource.data.updatedAt is string;
    }

    function isValidMessage() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'topic',
          'message',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() > 0;
    }

    match /profile/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /settings/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /story/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /now/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /work/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /writing/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /messages/{id} {
      allow create: if isValidMessage();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
