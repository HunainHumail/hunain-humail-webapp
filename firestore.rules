rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hunainhumail786@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isContentWrite() {
      return request.resource.data.keys().hasAll(['status', 'order', 'updatedAt'])
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.order is number
        && request.resource.data.updatedAt is string;
    }

    function isValidMessage() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'topic',
          'message',
          'createdAt',
          'blueprintLeadId'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() > 0
        && (!('blueprintLeadId' in request.resource.data)
          || (request.resource.data.blueprintLeadId is string
            && request.resource.data.blueprintLeadId.size() > 0
            && request.resource.data.blueprintLeadId.size() <= 128));
    }

    function isClientHealthEvent() {
      return request.resource.data.keys().hasOnly([
          'source',
          'type',
          'code',
          'message',
          'page',
          'ua',
          'sessionId',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'source',
          'type',
          'code',
          'message',
          'page',
          'ua',
          'sessionId',
          'createdAt'
        ])
        && request.resource.data.source == 'client'
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 64
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.ua is string
        && request.resource.data.ua.size() <= 120
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 40
        && request.resource.data.createdAt == request.time;
    }

    match /blueprintLeads/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted', 'archived'];
      allow create, delete: if false;
    }

    match /blueprintRateLimits/{id} {
      allow read, write: if false;
    }

    match /healthEvents/{id} {
      allow create: if isClientHealthEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /profile/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /settings/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /story/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /now/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /work/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /writing/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /testimonials/{id} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin() && isContentWrite();
    }

    match /messages/{id} {
      allow create: if isValidMessage();
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    match /cliSessions/{id} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'refreshToken',
          'email',
          'createdAt',
          'code'
        ])
        && request.resource.data.refreshToken is string
        && request.resource.data.refreshToken.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.code is string
        && request.resource.data.createdAt == request.time;
      allow get: if resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(10, 'm');
      allow list: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
