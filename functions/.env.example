# Copy to `functions/.env` for `firebase deploy` (non-interactive / CI).
# Secrets (GEMINI_API_KEY, BLUEPRINT_HASH_SALT) are set via Firebase CLI, not here.

BLUEPRINT_MODEL=gemini-3.5-flash-lite
BLUEPRINT_LIMIT_PER_IP_HOUR=5
BLUEPRINT_LIMIT_PER_EMAIL_HOUR=5
BLUEPRINT_DAILY_CAP=200
PUBLIC_SITE_URL=https://hunain-humail-webapp.web.app
