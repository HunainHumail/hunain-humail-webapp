# Optional — public site works without Firebase until CMS is configured
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match .firebaserc projects.default (hunain-humail-webapp)
# See docs/firebase.md

# Connect the web SDK and seed script to local emulators
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Spark plan: leave unset so the CMS offers an image URL instead of upload.
# Set to true only when Firebase Storage is enabled (or use the emulator).
# NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=true

# Canonical origin for metadata, sitemap, and robots. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://hunain-humail-webapp.web.app

# Static HTML export for Firebase Hosting. `npm run build:static` sets this.
# STATIC_EXPORT=true

# Playwright sets these for the e2e server only. Do not enable them in production.
# NEXT_PUBLIC_CONTACT_MOCK=true
# NEXT_PUBLIC_E2E_SIGNED_OUT=true

# Service account JSON for `npm run seed` against a real project
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
