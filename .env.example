# Optional — public site works without Firebase until CMS is configured
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match .firebaserc projects.default (placeholder: your-firebase-project-id)
# See docs/firebase.md

# Connect the web SDK and seed script to local emulators
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Spark plan: leave unset so the CMS offers an image URL instead of upload.
# Set to true only when Firebase Storage is enabled (or use the emulator).
# NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=true

# Service account JSON for `npm run seed` against a real project
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
