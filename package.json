{
  "name": "hunain-humail-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "STATIC_EXPORT=true next build",
    "start": "next start",
    "lhci": "lhci autorun",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-hunain-humail --config firebase.json \"vitest run --config vitest.rules.config.ts\"",
    "cms": "tsx scripts/cms.ts",
    "seed": "tsx scripts/seed.ts",
    "import-covers": "tsx scripts/import-covers.ts",
    "import-screenshot-covers": "tsx scripts/import-screenshot-covers.ts",
    "generate-placeholder-covers": "tsx scripts/generate-placeholder-covers.ts",
    "avatars": "tsx scripts/build-avatars.ts",
    "build:functions": "node functions/build.mjs",
    "setup:blueprint-secrets": "node scripts/setup-blueprint-secrets.mjs",
    "deploy:blueprint": "npm run build:functions && npx firebase deploy --only functions,firestore,hosting --project hunain-humail-webapp",
    "emulators": "firebase emulators:start --only firestore,auth,storage,functions,ui",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "@google/genai": "^1.30.0",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "firebase-functions": "^7.4.0",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
